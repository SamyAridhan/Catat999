{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node tests/app-logic.test.js && node tests/app-render.test.js && node tests/ui-regressions.test.js && TZ=Asia/Jakarta node tests/e2e-real-backend.test.js"
  },
  "mutate": [
    "web/app.js:127-211"
  ],
  "ignorePatterns": [
    "docs",
    "*.zip",
    "reports",
    "mutation-src"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 180000,
  "timeoutFactor": 1.5,
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/app-flows-a.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/app-flows-a.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}