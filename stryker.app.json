{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "node tests/app-logic.test.js && NO_SHOTS=1 node tests/ui.test.js" },
  "mutate": ["web/app.js"],
  "ignorePatterns": ["docs", "*.zip", "reports", "mutation-src", "apps-script"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 60000,
  "timeoutFactor": 1.5,
  "reporters": ["clear-text", "progress", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/app.json" },
  "htmlReporter": { "fileName": "reports/mutation/app.html" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
