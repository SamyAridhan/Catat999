{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node tests/app-logic.test.js"
  },
  "mutate": [
    "web/app.js:36-125",
    "web/app.js:310-400",
    "web/app.js:478-566"
  ],
  "ignorePatterns": [
    "docs",
    "*.zip",
    "reports",
    "mutation-src"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/app-logic.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/app-logic.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}