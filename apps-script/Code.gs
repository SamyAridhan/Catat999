/**
 * Catat 999 — backend for the 999 Mart payment log (phase 1: record payments after they happen).
 * Google Apps Script, bound to one Google Sheet.
 *
 * Tabs:
 *   <BLN YYYY>  – one per month, newest on the far left. Generated by this script (read-only reference).
 *   Data        – the single source of truth. Ibu may edit, add or delete rows here; month tabs update automatically.
 *   Supplier    – the list for the dropdown (one spelling each). Set Aktif = TIDAK to hide a name.
 *   Log         – who changed what, when (app edits/deletes, sheet edits, logins).
 *   Sesi        – login sessions (hidden).
 *
 * Security notes:
 *   - Passwords are never stored in the Sheet or the code: only salted, iterated SHA-256 hashes in Script Properties.
 *   - No default password; login is closed until set from the "Catat 999" menu.
 *   - Session tokens are random 256-bit values; only their hash is stored. Sessions expire after 90 days unused,
 *     and changing a password (or "Keluarkan semua HP") invalidates every session.
 *   - Every request is re-checked server-side (token, role, 3-day edit window). Inputs are validated and length-limited,
 *     text that could become a formula is neutralised, wrong passwords are throttled, writes are rate-limited.
 */

var APP_NAME = 'Catat 999';
var TITLE_PREFIX = '999 MART — ';   // first cell of every month tab the script builds (how it recognises its own tabs)
var TZ = 'Asia/Jakarta'; // Batam = WIB (UTC+7)
var SH = { DATA: 'Data', SUP: 'Supplier', LOG: 'Log', SES: 'Sesi' };
var AKTIF = 'AKTIF', DIHAPUS = 'DIHAPUS';
var PAY_FROM = ['Transfer Ibu', 'Uang Kasir', 'Modal'];
var BULAN = ['JAN', 'FEB', 'MAR', 'APR', 'MEI', 'JUN', 'JUL', 'AGU', 'SEP', 'OKT', 'NOV', 'DES'];
var BULAN_PANJANG = ['JANUARI', 'FEBRUARI', 'MARET', 'APRIL', 'MEI', 'JUNI', 'JULI', 'AGUSTUS', 'SEPTEMBER', 'OKTOBER', 'NOVEMBER', 'DESEMBER'];

var LIMIT = {
  maxAmount: 500000000,
  workerBackDays: 60,      // workers may date an entry at most this far back
  adminBackDays: 400,
  editDays: 3,             // workers may edit/delete entries recorded within this many days
  sessionDays: 90,
  minPassword: 8,
  failsPerDevice: 5,       // wrong passwords before that phone is locked out (15 min)
  failsGlobal: 30, failsGlobalHard: 300,         // wrong passwords from anywhere before all logins pause (15 min)
  writesPerMinute: 20,
  maxBody: 20000
};
var HASH_ROUNDS = 1000;
var ACTIONS = ['ping', 'login', 'logout', 'boot', 'add', 'update', 'remove', 'list'];

// Data columns (0-based). ID last and hidden, so Ibu sees the useful columns first.
var C = { DATE: 0, NAME: 1, INV: 2, AMT: 3, FROM: 4, BY: 5, NOTE: 6, AT: 7, EDITBY: 8, EDITAT: 9, STATUS: 10, ID: 11 };
var DATA_HEADERS = ['Tanggal', 'Nama PT / Barang', 'No. Invoice', 'Nominal', 'Bayar Pakai', 'Dicatat Oleh', 'Catatan',
  'Waktu Catat', 'Diubah Oleh', 'Waktu Ubah', 'Status', 'ID'];
var DATA_FORMATS = ['dd/mm/yyyy', '@', '@', '#,##0', '@', '@', '@', 'dd/mm/yyyy HH:mm', '@', 'dd/mm/yyyy HH:mm', '@', '@'];
var SUP_HEADERS = ['Nama PT / Barang', 'Aktif', 'Ditambah Oleh', 'Tgl Ditambah'];
var LOG_HEADERS = ['Waktu', 'Oleh', 'Aksi', 'Tanggal Transaksi', 'Nama PT / Barang', 'Keterangan', 'Perangkat', 'ID'];
var SES_HEADERS = ['Token (hash)', 'Nama', 'Peran', 'Dibuat', 'Terakhir Dipakai', 'Perangkat', 'Epoch'];

// ───────────────────────────── entry points ─────────────────────────────

function doGet() {
  return json_({ ok: true, app: APP_NAME });
}

function doPost(e) {
  var body = (e && e.postData && e.postData.contents) || '';
  if (body.length > LIMIT.maxBody) return json_({ ok: false, error: 'Permintaan terlalu besar.' });
  var req;
  try { req = JSON.parse(body || '{}'); } catch (err) { return json_({ ok: false, error: 'Permintaan tidak valid.' }); }
  if (!req || typeof req !== 'object' || Array.isArray(req)) return json_({ ok: false, error: 'Permintaan tidak valid.' });
  return json_(handle_(req));
}

/** Routes one request (separate from doPost so it can be tested). Never leaks internal errors. */
function handle_(req) {
  try {
    var action = String(req.action || '');
    if (ACTIONS.indexOf(action) < 0) return { ok: false, error: 'Aksi tidak dikenal.' };
    if (action === 'ping') return { ok: true };
    if (action === 'login') return login_(req.name, req.password, req.device);

    var sess = auth_(req.token);
    if (!sess) return { ok: false, code: 'AUTH', error: 'Sesi habis. Silakan masuk lagi.' };
    var user = sess.user;
    user.device = cleanDevice_(req.device);

    if (action === 'logout') { endSession_(sess); return { ok: true }; }
    if (action === 'boot') return boot_(user);
    if (action === 'list') return list_(user, req.month);

    if (!allowWrite_(sess.hash)) return { ok: false, error: 'Terlalu cepat. Tunggu sebentar lalu coba lagi.' };
    if (action === 'add') return withLock_(function () { return add_(user, req.entry || {}, req.force === true); });
    if (action === 'update') return withLock_(function () { return update_(user, req.id, req.entry || {}, req.force === true); });
    if (action === 'remove') return withLock_(function () { return remove_(user, req.id, req.reason); });
    return { ok: false, error: 'Aksi tidak dikenal.' };
  } catch (err) {
    console.error(err && err.stack ? err.stack : err);
    return { ok: false, error: 'Terjadi kesalahan di server. Coba lagi.' };
  }
}

// ───────────────────────────── passwords & sessions ─────────────────────────────

function props_() { return PropertiesService.getScriptProperties(); }

function hashPassword_(pw, salt) {
  var h = salt + ':' + pw;
  for (var i = 0; i < HASH_ROUNDS; i++) h = sha256_(h + ':' + salt);
  return h;
}

function sha256_(s) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, s, Utilities.Charset.UTF_8);
  var out = '';
  for (var i = 0; i < bytes.length; i++) { var b = bytes[i] < 0 ? bytes[i] + 256 : bytes[i]; out += (b < 16 ? '0' : '') + b.toString(16); }
  return out;
}

/** kind: 'worker' | 'admin'. Changing a password logs every phone out. */
function setPassword_(kind, pw) {
  pw = String(pw || '');
  if (pw.length < LIMIT.minPassword) throw new Error('Kata sandi minimal ' + LIMIT.minPassword + ' karakter.');
  if (/^\s|\s$/.test(pw)) throw new Error('Kata sandi tidak boleh diawali/diakhiri spasi.');
  var p = props_();
  var salt = p.getProperty('PW_SALT');
  if (!salt) { salt = Utilities.getUuid().replace(/-/g, ''); p.setProperty('PW_SALT', salt); }
  var other = p.getProperty(kind === 'admin' ? 'PW_WORKER' : 'PW_ADMIN');
  var h = hashPassword_(pw, salt);
  if (other && other === h) throw new Error('Kata sandi admin dan pekerja harus berbeda.');
  p.setProperty(kind === 'admin' ? 'PW_ADMIN' : 'PW_WORKER', h);
  bumpEpoch_();
  return 'OK';
}

function bumpEpoch_() {
  props_().setProperty('SES_EPOCH', String(Number(props_().getProperty('SES_EPOCH') || 0) + 1));
  CacheService.getScriptCache().put('epoch', props_().getProperty('SES_EPOCH'), 21600);
}

function epoch_() { return String(props_().getProperty('SES_EPOCH') || '0'); }

function login_(name, password, device) {
  var cache = CacheService.getScriptCache();
  var dev = cleanDevice_(device);
  var devKey = 'lf_' + sha256_(dev || 'unknown').slice(0, 24);
  var gFails = Number(cache.get('lf_all') || 0), dFails = Number(cache.get(devKey) || 0);
  // Per phone: 5 wrong tries → 15 min pause. Shop-wide: many failures only SLOW logins down, so a stranger
  // guessing passwords can't lock every worker out; a hard stop only kicks in under a sustained attack.
  if (dFails >= LIMIT.failsPerDevice || gFails >= LIMIT.failsGlobalHard) {
    return { ok: false, error: 'Terlalu banyak percobaan. Coba lagi 15 menit lagi.' };
  }
  if (gFails >= LIMIT.failsGlobal) Utilities.sleep(3000);
  var nm = cleanPersonName_(name);
  if (!nm) return { ok: false, error: 'Isi nama Anda (huruf saja, 2–30 karakter).' };
  var pw = String(password || '');
  if (!pw || pw.length > 100) return { ok: false, error: 'Isi kata sandi.' };

  var p = props_();
  var salt = p.getProperty('PW_SALT'), hw = p.getProperty('PW_WORKER'), ha = p.getProperty('PW_ADMIN');
  if (!salt || (!hw && !ha)) return { ok: false, error: 'Aplikasi belum siap: kata sandi belum diatur di spreadsheet.' };

  var h = hashPassword_(pw, salt);
  var role = (ha && h === ha) ? 'ADMIN' : (hw && h === hw) ? 'PEKERJA' : '';
  if (!role) {
    cache.put('lf_all', String(gFails + 1), 900);
    cache.put(devKey, String(dFails + 1), 900);
    log_({ name: nm, device: dev }, 'Gagal masuk', null, 'Kata sandi salah');
    Utilities.sleep(1000);
    return { ok: false, error: 'Kata sandi salah.' };
  }
  cache.remove(devKey);
  var token = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '').toLowerCase();
  var now = new Date();
  var sh = sheet_(SH.SES);
  var r = sh.getLastRow() + 1;
  ensureRows_(sh, r);
  sh.getRange(r, 1, 1, SES_HEADERS.length).setValues([[sha256_(token), safeText_(nm), role, now, now, safeText_(dev), epoch_()]]);
  log_({ name: nm, device: dev }, role === 'ADMIN' ? 'Masuk (admin)' : 'Masuk', null, '');
  return { ok: true, token: token, name: nm, role: role };
}

/** Returns { user:{name, role}, hash, row } or null. */
function auth_(token) {
  token = String(token || '');
  if (!/^[a-f0-9]{64}$/.test(token)) return null;
  var hash = sha256_(token);
  var ses = sheet_(SH.SES), lastRow = ses.getLastRow();
  if (lastRow < 2) return null;
  // NOT readTable_: it skips blank rows (left by logouts), which would shift every row number below them
  var rows = ses.getRange(2, 1, lastRow - 1, SES_HEADERS.length).getValues();
  var ep = epoch_();
  for (var i = 0; i < rows.length; i++) {
    if (rows[i][0] !== hash) continue;
    var r = rows[i];
    if (String(r[6]) !== ep) return null;
    var last = r[4] instanceof Date ? r[4].getTime() : 0;
    if (Date.now() - last > LIMIT.sessionDays * 86400000) return null;
    if (Date.now() - last > 3600000) ses.getRange(i + 2, 5).setValue(new Date());
    return { user: { name: String(r[1]).replace(/^'/, ''), role: r[2] === 'ADMIN' ? 'ADMIN' : 'PEKERJA' }, hash: hash, row: i + 2 };
  }
  return null;
}

function endSession_(sess) {
  sheet_(SH.SES).getRange(sess.row, 1, 1, SES_HEADERS.length).setValues([['', '', '', '', '', '', '']]);
}

function allowWrite_(hash) {
  var cache = CacheService.getScriptCache();
  var k = 'wr_' + hash.slice(0, 24);
  var n = Number(cache.get(k) || 0);
  if (n >= LIMIT.writesPerMinute) return false;
  cache.put(k, String(n + 1), 60);
  return true;
}

// ───────────────────────────── read ─────────────────────────────

function boot_(user) {
  var today = todayStr_();
  var rows = readTable_(SH.DATA, DATA_HEADERS.length);
  var freq = {}, todayCount = 0, cutoff = addDays_(today, -60);
  rows.forEach(function (r) {
    if (isDeleted_(r)) return;
    var d = fmtDate_(r[C.DATE]);
    if (d >= cutoff) freq[r[C.NAME]] = (freq[r[C.NAME]] || 0) + 1;
    if (fmtDate_(r[C.AT]) === today) todayCount++;
  });
  return {
    ok: true, user: { name: user.name, role: user.role }, today: today, payFrom: PAY_FROM,
    suppliers: listSuppliers_(),
    frequent: Object.keys(freq).sort(function (a, b) { return freq[b] - freq[a]; }).slice(0, 10).map(unquote_),
    todayCount: todayCount,
    limits: { maxAmount: LIMIT.maxAmount, backDays: user.role === 'ADMIN' ? LIMIT.adminBackDays : LIMIT.workerBackDays, editDays: LIMIT.editDays }
  };
}

function list_(user, month) {
  month = String(month || '');
  if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) return { ok: false, error: 'Bulan tidak valid.' };
  var rows = readTable_(SH.DATA, DATA_HEADERS.length);
  var out = [], total = 0;
  rows.forEach(function (r) {
    if (isDeleted_(r) || fmtDate_(r[C.DATE]).slice(0, 7) !== month) return;
    var o = rowToObj_(r);
    o.canEdit = canEdit_(user, r);
    out.push(o); total += o.amount;
  });
  out.sort(function (a, b) { return a.date !== b.date ? (a.date < b.date ? 1 : -1) : (a.at < b.at ? 1 : -1); });
  return { ok: true, month: month, entries: out, total: total };
}

function listSuppliers_() {
  return readTable_(SH.SUP, SUP_HEADERS.length)
    .filter(function (s) { return String(s[0]).trim() && !/^(TIDAK|NO|N|FALSE|0)$/i.test(String(s[1]).trim()); })
    .map(function (s) { return unquote_(String(s[0]).trim()); });
}

// ───────────────────────────── write ─────────────────────────────

function add_(user, e, force) {
  var id = String(e.id || '');
  if (!/^[A-Za-z0-9_-]{8,64}$/.test(id)) return { ok: false, error: 'ID transaksi tidak valid.' };
  var data = readTable_(SH.DATA, DATA_HEADERS.length);
  for (var i = 0; i < data.length; i++) if (data[i][C.ID] === id) return { ok: true, already: true, entry: rowToObj_(data[i]) };

  var v = validateEntry_(e, user);
  if (v.error) return { ok: false, code: 'INVALID', error: v.error };
  v.name = supplierName_(v.name, user);
  if (!force) {
    var dup = findDuplicate_(data, v, null);
    if (dup) return dup;
  }
  var row = [];
  row[C.DATE] = toDate_(v.date); row[C.NAME] = v.name; row[C.INV] = v.invoice; row[C.AMT] = v.amount;
  row[C.FROM] = v.paidFrom; row[C.BY] = user.name; row[C.NOTE] = v.note; row[C.AT] = new Date();
  row[C.EDITBY] = ''; row[C.EDITAT] = ''; row[C.STATUS] = AKTIF; row[C.ID] = id;
  writeRow_(sheet_(SH.DATA).getLastRow() + 1, row);
  log_(user, 'Tambah', rowToObj_(row), rupiah_(v.amount) + ' · ' + v.paidFrom + (force ? ' · disimpan walau ada yang mirip' : ''));
  refreshViews_([v.date.slice(0, 7)]);
  return { ok: true, entry: rowToObj_(row) };
}

function update_(user, id, e, force) {
  var found = findRow_(String(id || ''));
  if (!found) return { ok: false, error: 'Transaksi tidak ditemukan. Mungkin sudah dihapus — muat ulang Riwayat.' };
  var r = found.row;
  if (isDeleted_(r)) return { ok: false, error: 'Transaksi ini sudah dihapus.' };
  if (!canEdit_(user, r)) return { ok: false, error: editDeniedMsg_(r) };
  var v = validateEntry_(e, user, fmtDate_(r[C.DATE]));
  if (v.error) return { ok: false, code: 'INVALID', error: v.error };
  v.name = supplierName_(v.name, user);
  if (!force) {
    var dup = findDuplicate_(readTable_(SH.DATA, DATA_HEADERS.length), v, r[C.ID]);
    if (dup) return dup;
  }
  var before = rowToObj_(r);
  var oldMonth = before.date.slice(0, 7);
  r[C.DATE] = toDate_(v.date); r[C.NAME] = v.name; r[C.INV] = v.invoice; r[C.AMT] = v.amount;
  r[C.FROM] = v.paidFrom; r[C.NOTE] = v.note; r[C.EDITBY] = user.name; r[C.EDITAT] = new Date();
  var after = rowToObj_(r);
  var diff = describeChanges_(before, after);
  if (!diff) return { ok: true, unchanged: true, entry: after };
  writeRow_(found.index + 2, r);
  log_(user, 'Ubah', after, diff);
  refreshViews_([oldMonth, v.date.slice(0, 7)]);
  return { ok: true, entry: after };
}

function remove_(user, id, reason) {
  var found = findRow_(String(id || ''));
  if (!found) return { ok: false, error: 'Transaksi tidak ditemukan. Mungkin sudah dihapus — muat ulang Riwayat.' };
  var r = found.row;
  if (isDeleted_(r)) return { ok: true, already: true };
  if (!canEdit_(user, r)) return { ok: false, error: editDeniedMsg_(r) };
  reason = cleanFree_(reason, 100);
  if (!reason) return { ok: false, error: 'Pilih alasan hapus.' };
  r[C.STATUS] = DIHAPUS; r[C.EDITBY] = user.name; r[C.EDITAT] = new Date();
  writeRow_(found.index + 2, r);
  var o = rowToObj_(r);
  log_(user, 'Hapus', o, 'Alasan: ' + reason + ' · ' + rupiah_(o.amount));
  refreshViews_([o.date.slice(0, 7)]);
  return { ok: true };
}

function canEdit_(user, r) {
  if (isDeleted_(r)) return false;
  if (user.role === 'ADMIN') return true;
  var at = r[C.AT] instanceof Date ? r[C.AT].getTime() : 0;
  return at > 0 && Date.now() - at <= LIMIT.editDays * 86400000;
}

function editDeniedMsg_() {
  return 'Transaksi lebih dari ' + LIMIT.editDays + ' hari hanya bisa diubah oleh Ibu.';
}

function writeRow_(rowNum, row) {
  var sh = sheet_(SH.DATA);
  ensureRows_(sh, rowNum);
  var out = row.map(function (v, i) { return typeof v === 'string' ? safeText_(v) : (v === undefined || v === null ? '' : v); });
  var rng = sh.getRange(rowNum, 1, 1, DATA_HEADERS.length);
  rng.setNumberFormats([DATA_FORMATS]);
  rng.setValues([out]);
}

function supplierName_(name, user) {
  var sh = sheet_(SH.SUP);
  var rows = readTable_(SH.SUP, SUP_HEADERS.length);
  var k = nameKey_(name);
  for (var i = 0; i < rows.length; i++) {
    if (nameKey_(rows[i][0]) === k) {
      if (/^(TIDAK|NO|N|FALSE|0)$/i.test(String(rows[i][1]).trim())) sh.getRange(i + 2, 2).setValue('YA');
      return unquote_(String(rows[i][0]).trim());
    }
  }
  var r = sh.getLastRow() + 1;
  ensureRows_(sh, r);
  sh.getRange(r, 1, 1, SUP_HEADERS.length).setNumberFormats([['@', '@', '@', 'dd/mm/yyyy']])
    .setValues([[safeText_(name), 'YA', safeText_(user.name), new Date()]]);
  return name;
}

function findDuplicate_(data, v, selfId) {
  var key = nameKey_(v.name);
  var inv = v.invoice.replace(/^0+/, '');
  for (var i = data.length - 1; i >= 0; i--) {
    var r = data[i];
    if (isDeleted_(r) || r[C.ID] === selfId || nameKey_(r[C.NAME]) !== key) continue;
    if (inv && String(r[C.INV]).replace(/^'/, '').trim().toUpperCase().replace(/^0+/, '') === inv) {
      return { ok: false, code: 'DUP_INVOICE', error: 'Invoice ini sudah pernah dicatat.', existing: rowToObj_(r) };
    }
    if (!inv && fmtDate_(r[C.DATE]) === v.date && Number(r[C.AMT]) === v.amount) {
      return { ok: false, code: 'DUP_SIMILAR', error: 'Sudah ada transaksi yang sama di tanggal itu.', existing: rowToObj_(r) };
    }
  }
  return null;
}

// ───────────────────────────── validation & sanitising ─────────────────────────────

function validateEntry_(e, user, keepDate) {
  if (!e || typeof e !== 'object') return { error: 'Data tidak valid.' };
  var out = {};
  out.date = String(e.date || '');
  // when editing, a date that stays the same is not refused for being "too old" (still never in the future)
  var back = keepDate && out.date === keepDate ? 100000 : (user.role === 'ADMIN' ? LIMIT.adminBackDays : LIMIT.workerBackDays);
  var dErr = checkDate_(out.date, back);
  if (dErr) return { error: dErr };
  out.name = cleanSupplierName_(e.name);
  if (!out.name) return { error: 'Nama PT / barang wajib diisi.' };
  out.invoice = cleanInvoice_(e.invoice);
  if (out.invoice === null) return { error: 'No. invoice hanya boleh huruf, angka, - dan / (maks. 30).' };
  var amt = typeof e.amount === 'number' ? e.amount : Number(String(e.amount === undefined ? '' : e.amount).replace(/[^\d]/g, ''));
  if (!isFinite(amt) || Math.floor(amt) !== amt || amt <= 0) return { error: 'Nominal wajib diisi.' };
  if (amt > LIMIT.maxAmount) return { error: 'Nominal terlalu besar. Cek lagi.' };
  out.amount = amt;
  out.paidFrom = cleanPayFrom_(e.paidFrom);
  if (!out.paidFrom) return { error: 'Pilih bayar pakai apa.' };
  out.note = cleanFree_(e.note, 200);
  return out;
}

function checkDate_(s, backDays) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return 'Tanggal tidak valid.';
  var p = s.split('-').map(Number);
  var d = new Date(p[0], p[1] - 1, p[2]);
  if (d.getFullYear() !== p[0] || d.getMonth() !== p[1] - 1 || d.getDate() !== p[2]) return 'Tanggal tidak valid.';
  var today = todayStr_();
  if (s > today) return 'Tanggal tidak boleh lebih dari hari ini.';
  if (s < addDays_(today, -backDays)) return 'Tanggal terlalu lama. Minta Ibu untuk mencatat.';
  return '';
}

/** Only plain strings and numbers count as text; objects/arrays sent by a malicious client become ''. */
function text_(v) { return typeof v === 'string' ? v : (typeof v === 'number' && isFinite(v) ? String(v) : ''); }

function cleanSupplierName_(v) {
  var s = text_(v).toUpperCase()
    .replace(/[^A-Z0-9 .,&\/()'+\-]/g, ' ').replace(/\s+/g, ' ').trim();
  s = s.replace(/^[=+\-@\s]+/, '').trim();
  return s.length > 60 ? s.slice(0, 60).trim() : s;
}

function cleanInvoice_(v) {
  var s = text_(v).toUpperCase().replace(/\s+/g, '').trim();
  if (!s) return '';
  if (!/^[A-Z0-9\-\/.]{1,30}$/.test(s)) return null;
  return s;
}

function cleanPersonName_(v) {
  var s = text_(v).toUpperCase().replace(/\s+/g, ' ').trim();
  return /^[A-Z][A-Z .'\-]{1,29}$/.test(s) ? s : '';
}

function cleanPayFrom_(v) {
  var s = text_(v).trim();
  for (var i = 0; i < PAY_FROM.length; i++) if (s.toUpperCase() === PAY_FROM[i].toUpperCase()) return PAY_FROM[i];
  var m = /^lainnya\s*:?\s*(.*)$/i.exec(s);
  if (m) {
    var who = m[1].toUpperCase().replace(/[^A-Z .'\-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 30);
    return who ? 'Lainnya: ' + who : '';
  }
  return '';
}

function cleanFree_(v, max) {
  return text_(v).replace(/[\u0000-\u001F\u007F]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, max).trim();
}

function cleanDevice_(v) { return cleanFree_(v, 120); }

/** Text that starts like a formula is stored as plain text (leading apostrophe; Sheets hides it). */
function safeText_(s) {
  s = String(s);
  // a leading apostrophe is also protected, so text that really starts with ' survives the round trip
  return /^[=+\-@\t\r']/.test(s) ? "'" + s : s;
}
function unquote_(s) { return String(s).replace(/^'/, ''); }

/** Key that treats "PT. Yafindo  Mitra-Permata" and "pt yafindo mitra permata" as the same supplier. */
function nameKey_(v) {
  return String(v || '').replace(/^'/, '').toUpperCase().replace(/^\s*(PT|CV|UD)\b\.?/, '').replace(/[^A-Z0-9]/g, '');
}

// ───────────────────────────── month tabs ─────────────────────────────

function refreshViews_(months) {
  var rows = readTable_(SH.DATA, DATA_HEADERS.length);
  var seen = {};
  (months || []).forEach(function (m) { if (/^\d{4}-\d{2}$/.test(m || '') && !seen[m]) { seen[m] = true; buildMonth_(m, rows); } });
}

function buildMonth_(ym, rows) {
  var y = Number(ym.slice(0, 4)), m = Number(ym.slice(5, 7));
  var name = BULAN[m - 1] + ' ' + y;
  var ss = ss_();
  var sh = ss.getSheetByName(name);
  var list = rows.filter(function (r) { return !isDeleted_(r) && fmtDate_(r[C.DATE]).slice(0, 7) === ym; })
    .sort(function (a, b) {
      var da = fmtDate_(a[C.DATE]), db = fmtDate_(b[C.DATE]);
      return da !== db ? (da < db ? -1 : 1) : toTime_(a[C.AT]) - toTime_(b[C.AT]);
    });
  // A tab with this name that the script did NOT build (e.g. Ibu pasted an old month sheet) is moved aside, never wiped.
  if (sh && sh.getLastRow() > 0 && String(sh.getRange(1, 1).getValue()).indexOf(TITLE_PREFIX) !== 0) {
    var alt = name + ' (lama)', k = 2;
    while (ss.getSheetByName(alt)) alt = name + ' (lama ' + (k++) + ')';
    sh.setName(alt);
    log_({ name: 'SISTEM', device: '' }, 'Tab dipindah', null, 'Tab "' + name + '" bukan buatan aplikasi, diganti nama jadi "' + alt + '"');
    sh = null;
  }
  if (!sh) {
    if (!list.length) return;              // never create an empty tab
    sh = ss.insertSheet(name, monthSheetIndex_(ss, ym));
  }
  sh.clear();

  var W = 7;
  var total = 0, byFrom = { 'Transfer Ibu': 0, 'Uang Kasir': 0, 'Modal': 0, 'Lainnya': 0 }, bySup = {};
  list.forEach(function (r) {
    var a = Number(r[C.AMT]) || 0;
    total += a;
    var f = unquote_(r[C.FROM] || '');
    byFrom[/^Lainnya/.test(f) || !(f in byFrom) ? 'Lainnya' : f] += a;
    var n = unquote_(r[C.NAME]);
    var s = bySup[n] || (bySup[n] = [0, 0]); s[0]++; s[1] += a;
  });

  var out = [], kinds = [];
  function push(arr, kind) { arr = arr.slice(); while (arr.length < W) arr.push(''); out.push(arr); kinds.push(kind || ''); }
  push([TITLE_PREFIX + BULAN_PANJANG[m - 1] + ' ' + y, '', '', 'Otomatis dari aplikasi ' + APP_NAME + '. Untuk mengubah: lewat aplikasi atau tab Data. Diperbarui ' +
    Utilities.formatDate(new Date(), TZ, 'dd/MM HH:mm') + '.'], 'title');
  push(['Total', 'Transfer Ibu', 'Uang Kasir', 'Modal', 'Lainnya', 'Transaksi'], 'sumlabel');
  push([total, byFrom['Transfer Ibu'], byFrom['Uang Kasir'], byFrom['Modal'], byFrom['Lainnya'], list.length], 'sumvalue');
  push([], '');
  var headerRow = out.length + 1;
  push(['Tanggal', 'Nama PT / Barang', 'No. Invoice', 'Nominal', 'Bayar Pakai', 'Dicatat Oleh', 'Catatan'], 'header');
  var day = null, dayTotal = 0;
  function closeDay() { if (day) push(['', 'Total ' + day.slice(8, 10) + '/' + day.slice(5, 7), '', dayTotal, '', '', ''], 'daytotal'); }
  list.forEach(function (r) {
    var d = fmtDate_(r[C.DATE]);
    if (d !== day) { closeDay(); day = d; dayTotal = 0; }
    dayTotal += Number(r[C.AMT]) || 0;
    push([r[C.DATE], unquote_(r[C.NAME]), unquote_(r[C.INV] || ''), Number(r[C.AMT]) || 0, unquote_(r[C.FROM] || ''), unquote_(r[C.BY] || ''), unquote_(r[C.NOTE] || '')], 'entry');
  });
  closeDay();
  push([], '');
  push(['TOTAL PER SUPPLIER', '', 'Transaksi', 'Total', '', '', ''], 'header');
  Object.keys(bySup).sort(function (a, b) { return bySup[b][1] - bySup[a][1]; })
    .forEach(function (k) { push(['', k, bySup[k][0], bySup[k][1], '', '', ''], 'sup'); });

  sh.getRange(1, 1, out.length, W).setValues(out.map(function (r) { return r.map(function (v) { return typeof v === 'string' ? safeText_(v) : v; }); }));

  // formats + styles in a few batched calls (one call per row would make every save slow)
  var nf = [], fw = [], bg = [], fc = [];
  out.forEach(function (row, i) {
    var k = kinds[i];
    nf.push(row.map(function (_, j) {
      if (k === 'sumvalue') return j === 5 ? '0' : '#,##0';
      if (k === 'entry') return j === 0 ? 'dd/mm/yyyy' : j === 3 ? '#,##0' : '@';
      if (k === 'daytotal' || k === 'sup') return j === 3 ? '#,##0' : '@';
      return '@';
    }));
    var bold = k === 'title' || k === 'sumvalue' || k === 'header' || k === 'daytotal';
    fw.push(row.map(function (_, j) { return bold && !(k === 'title' && j > 0) ? 'bold' : 'normal'; }));
    bg.push(row.map(function () { return k === 'header' || k === 'sumlabel' ? '#e8eef7' : k === 'daytotal' ? '#fff4d6' : null; }));
    fc.push(row.map(function (_, j) { return (k === 'title' && j > 0) || k === 'sumlabel' ? '#666666' : '#000000'; }));
  });
  var all = sh.getRange(1, 1, out.length, W);
  all.setNumberFormats(nf); all.setFontWeights(fw); all.setBackgrounds(bg); all.setFontColors(fc);
  sh.getRange(1, 1).setFontSize(14);
  sh.setFrozenRows(headerRow);
  [100, 260, 100, 115, 120, 110, 200].forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
}

/** Month tabs sit at the far left, newest first. */
function monthSheetIndex_(ss, ym) {
  var sheets = ss.getSheets(), idx = 0;
  for (var i = 0; i < sheets.length; i++) {
    var p = parseMonthName_(sheets[i].getName());
    if (p && p > ym) idx = i + 1;
  }
  return idx;
}

function parseMonthName_(n) {
  var m = /^([A-Z]{3}) (\d{4})$/.exec(String(n));
  if (!m) return null;
  var k = BULAN.indexOf(m[1]);
  return k < 0 ? null : m[2] + '-' + ('0' + (k + 1)).slice(-2);
}

// ───────────────────────────── setup, menu, sheet edits ─────────────────────────────

/** Run once from the Apps Script editor. Safe to run again. Does NOT set passwords (use the menu). */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  props_().setProperty('SS_ID', ss.getId());
  ss.setSpreadsheetTimeZone(TZ);
  ss.setSpreadsheetLocale('id_ID');

  var data = ensureSheet_(SH.DATA, DATA_HEADERS);
  var max = data.getMaxRows() - 1;
  DATA_FORMATS.forEach(function (f, i) { data.getRange(2, i + 1, max, 1).setNumberFormat(f); });
  data.hideColumns(C.ID + 1);
  [100, 260, 100, 115, 120, 110, 200, 130, 110, 130, 80, 60].forEach(function (w, i) { data.setColumnWidth(i + 1, w); });
  if (!data.getFilter()) data.getRange(1, 1, data.getMaxRows(), DATA_HEADERS.length).createFilter();
  if (!data.getProtections(SpreadsheetApp.ProtectionType.SHEET).length) {
    data.protect().setDescription('Boleh diubah. Tab bulanan ikut diperbarui otomatis.').setWarningOnly(true);
  }

  var sup = ensureSheet_(SH.SUP, SUP_HEADERS);
  if (sup.getLastRow() < 2) {
    var seed = SEED_SUPPLIERS.map(function (s) { return [s[0], 'YA', 'SETUP', new Date()]; });
    sup.getRange(2, 1, seed.length, SUP_HEADERS.length).setValues(seed);
  }
  sup.setColumnWidth(1, 300);

  var log = ensureSheet_(SH.LOG, LOG_HEADERS);
  if (!log.getProtections(SpreadsheetApp.ProtectionType.SHEET).length) log.protect().setDescription('Catatan otomatis').setWarningOnly(true);
  var ses = ensureSheet_(SH.SES, SES_HEADERS);
  ses.hideSheet();

  // installable triggers: run with full permission when Ibu edits Data directly
  var have = ScriptApp.getProjectTriggers().map(function (t) { return t.getHandlerFunction(); });
  if (have.indexOf('onDataEdit') < 0) ScriptApp.newTrigger('onDataEdit').forSpreadsheet(ss).onEdit().create();
  if (have.indexOf('onDataChange') < 0) ScriptApp.newTrigger('onDataChange').forSpreadsheet(ss).onChange().create();

  // order: month tabs first, then Data, Supplier, Log (Sesi hidden at the end)
  [SH.DATA, SH.SUP, SH.LOG, SH.SES].forEach(function (n) { ss.setActiveSheet(ss.getSheetByName(n)); ss.moveActiveSheet(ss.getSheets().length); });
  var junk = ss.getSheetByName('Sheet1') || ss.getSheetByName('Lembar1');
  if (junk && junk.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(junk);
  refreshAll();
  return 'OK';
}

function refreshAll() {
  var rows = readTable_(SH.DATA, DATA_HEADERS.length);
  var months = {};
  rows.forEach(function (r) { var d = fmtDate_(r[C.DATE]); if (d) months[d.slice(0, 7)] = true; });
  // also rebuild existing month tabs (a month may now be empty after deletions)
  ss_().getSheets().forEach(function (s) { var p = parseMonthName_(s.getName()); if (p) months[p] = true; });
  Object.keys(months).sort().forEach(function (m) { buildMonth_(m, rows); });
}

function onOpen() {
  SpreadsheetApp.getUi().createMenu(APP_NAME)
    .addItem('Perbarui semua tab', 'refreshAll')
    .addSeparator()
    .addItem('Atur kata sandi pekerja', 'menuWorkerPassword')
    .addItem('Atur kata sandi admin (Ibu)', 'menuAdminPassword')
    .addItem('Keluarkan semua HP', 'menuLogoutAll')
    .addSeparator()
    .addItem('Siapkan / perbaiki struktur', 'setup')
    .addToUi();
}

function menuWorkerPassword() { askPassword_('worker', 'Kata sandi pekerja (dipakai semua pekerja)'); }
function menuAdminPassword() { askPassword_('admin', 'Kata sandi admin (hanya untuk Ibu)'); }
function askPassword_(kind, title) {
  var ui = SpreadsheetApp.getUi();
  var r = ui.prompt(title, 'Minimal ' + LIMIT.minPassword + ' karakter. Semua HP akan keluar dan harus masuk lagi.', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  try { setPassword_(kind, r.getResponseText()); ui.alert('Kata sandi disimpan. Semua HP harus masuk lagi.'); }
  catch (err) { ui.alert(err.message); }
}
function menuLogoutAll() {
  bumpEpoch_();
  SpreadsheetApp.getUi().alert('Semua HP sudah dikeluarkan. Pekerja harus masuk lagi.');
}

/** Installable trigger: Ibu edits or adds rows in Data → fill ID etc., log it, refresh the month tab(s). */
function onDataEdit(e) {
  if (!e || !e.range) return;
  var sh = e.range.getSheet();
  if (sh.getName() !== SH.DATA) return;
  var r0 = Math.max(2, e.range.getRow()), n = e.range.getRow() + e.range.getNumRows() - r0;
  if (n <= 0) return;
  var vals = sh.getRange(r0, 1, n, DATA_HEADERS.length).getValues();
  var months = {};
  var email = '';
  try { email = e.user && e.user.getEmail ? e.user.getEmail() : ''; } catch (err) { }
  var who = { name: email || 'SHEET', device: 'Google Sheets' };
  // IDs used by OTHER rows: a pasted copy of a row brings its hidden ID along and must get a new one
  var last = sh.getLastRow(), idCount = {};
  if (last >= 2) sh.getRange(2, C.ID + 1, last - 1, 1).getValues().forEach(function (x) { if (x[0]) idCount[x[0]] = (idCount[x[0]] || 0) + 1; });
  vals.forEach(function (r, i) {
    var empty = !r.slice(0, 7).some(function (c) { return c !== '' && c !== null; });
    if (empty) return;
    var row = r0 + i;
    var fixed = normalizeTypedRow_(r);   // "01/11/2026" typed as text → real date, "350.000" → number
    var d = fmtDate_(r[C.DATE]); if (d) months[d.slice(0, 7)] = true;
    // Only the cells the script changes are written back — never re-write text Ibu typed: Sheets hands text back
    // without its protective apostrophe, so writing it again could turn "'+62…" or "'=…" into a number/formula.
    var put = function (col, v) { sh.getRange(row, col + 1).setValue(typeof v === 'string' ? safeText_(v) : v); };
    if (fixed) { put(C.DATE, r[C.DATE]); put(C.AMT, r[C.AMT]); }
    var copied = !!r[C.ID] && idCount[r[C.ID]] > 1 && isLaterCopy_(sh, row, r[C.ID]);
    if (!r[C.ID] || copied) {
      r[C.ID] = 'm' + Utilities.getUuid().replace(/-/g, '').slice(0, 15);
      if (copied) { r[C.BY] = 'MANUAL'; r[C.AT] = new Date(); r[C.EDITBY] = ''; r[C.EDITAT] = ''; put(C.EDITBY, ''); put(C.EDITAT, ''); }
      r[C.BY] = r[C.BY] || 'MANUAL'; r[C.AT] = r[C.AT] || new Date(); r[C.STATUS] = r[C.STATUS] || AKTIF;
      var clean = typeof r[C.NAME] === 'string' ? cleanSupplierName_(r[C.NAME]) : '';
      if (clean && clean !== r[C.NAME]) { r[C.NAME] = clean; put(C.NAME, clean); }
      put(C.ID, r[C.ID]); put(C.BY, r[C.BY]); put(C.AT, r[C.AT]); put(C.STATUS, r[C.STATUS]);
      log_(who, 'Tambah manual', rowToObj_(r), copied ? 'Baris disalin di sheet (ID baru)' : 'Ditambah langsung di sheet');
    } else {
      log_(who, 'Ubah manual', rowToObj_(r), e.range.getNumRows() === 1 && e.range.getNumColumns() === 1
        ? DATA_HEADERS[e.range.getColumn() - 1] + ': ' + String(e.oldValue === undefined ? '' : e.oldValue) + ' → ' + String(e.value === undefined ? '' : e.value)
        : 'Beberapa sel diubah');
    }
  });
  if (e.oldValue && e.range.getColumn() === C.DATE + 1) {
    var od = parseLooseDate_(e.oldValue); if (od) months[od.slice(0, 7)] = true;
  }
  refreshViews_(Object.keys(months));
}

/** True when another row ABOVE this one already carries the same ID (so this row is the pasted copy). */
function isLaterCopy_(sh, row, id) {
  if (row <= 2) return false;
  var above = sh.getRange(2, C.ID + 1, row - 2, 1).getValues();
  for (var i = 0; i < above.length; i++) if (above[i][0] === id) return true;
  return false;
}

/** Installable trigger: rows deleted/inserted in Data → rebuild all month tabs. */
function onDataChange(e) {
  if (e && ['REMOVE_ROW', 'INSERT_ROW', 'OTHER'].indexOf(e.changeType) >= 0) refreshAll();
}

// ───────────────────────────── log ─────────────────────────────

function log_(user, action, entry, detail) {
  try {
    var sh = ss_().getSheetByName(SH.LOG);
    if (!sh) return;
    sh.appendRow([new Date(), safeText_(user.name || ''), action, entry ? entry.date : '', entry ? safeText_(entry.name) : '',
      safeText_(cleanFree_(detail, 300)), safeText_(user.device || ''), entry ? entry.id : '']);
  } catch (err) { console.error(err); }
}

function describeChanges_(a, b) {
  var parts = [];
  if (a.date !== b.date) parts.push('Tanggal: ' + dmy_(a.date) + ' → ' + dmy_(b.date));
  if (a.name !== b.name) parts.push('Nama: ' + a.name + ' → ' + b.name);
  if (a.invoice !== b.invoice) parts.push('Invoice: ' + (a.invoice || '-') + ' → ' + (b.invoice || '-'));
  if (a.amount !== b.amount) parts.push('Nominal: ' + rupiah_(a.amount) + ' → ' + rupiah_(b.amount));
  if (a.paidFrom !== b.paidFrom) parts.push('Bayar pakai: ' + a.paidFrom + ' → ' + b.paidFrom);
  if (a.note !== b.note) parts.push('Catatan: ' + (a.note || '-') + ' → ' + (b.note || '-'));
  return parts.join('; ');
}

// ───────────────────────────── helpers ─────────────────────────────

function ss_() {
  var id = props_().getProperty('SS_ID');
  return id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
}

function sheet_(name) {
  var sh = ss_().getSheetByName(name);
  if (!sh) throw new Error('Tab "' + name + '" tidak ada. Jalankan setup() dulu.');
  return sh;
}

function ensureSheet_(name, headers) {
  var ss = ss_();
  var sh = ss.getSheetByName(name) || ss.insertSheet(name);
  sh.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold').setBackground('#e8eef7');
  sh.setFrozenRows(1);
  return sh;
}

function ensureRows_(sh, r) {
  var max = sh.getMaxRows();
  if (r > max) sh.insertRowsAfter(max, Math.max(500, r - max));
}

function readTable_(name, width) {
  var sh = sheet_(name);
  var last = sh.getLastRow();
  if (last < 2) return [];
  return sh.getRange(2, 1, last - 1, width).getValues().filter(function (r) {
    return r.some(function (c) { return c !== '' && c !== null; });
  });
}

function findRow_(id) {
  if (!id) return null;
  var sh = sheet_(SH.DATA);
  var last = sh.getLastRow();
  if (last < 2) return null;
  var rows = sh.getRange(2, 1, last - 1, DATA_HEADERS.length).getValues();
  for (var i = 0; i < rows.length; i++) if (rows[i][C.ID] === id) return { index: i, row: rows[i] };
  return null;
}

function isDeleted_(r) { return String(r[C.STATUS]).trim().toUpperCase() === DIHAPUS; }

function rowToObj_(r) {
  return {
    id: r[C.ID], date: fmtDate_(r[C.DATE]), name: unquote_(r[C.NAME] || ''), invoice: unquote_(r[C.INV] || ''),
    amount: Number(r[C.AMT]) || 0, paidFrom: unquote_(r[C.FROM] || ''), by: unquote_(r[C.BY] || ''), note: unquote_(r[C.NOTE] || ''),
    at: fmtDateTime_(r[C.AT]), editedBy: unquote_(r[C.EDITBY] || ''), editedAt: fmtDateTime_(r[C.EDITAT])
  };
}

function withLock_(fn) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return { ok: false, error: 'Server sibuk, coba lagi sebentar.' };
  try { return fn(); } finally { lock.releaseLock(); }
}

function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }

function todayStr_() { return Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd'); }

function fmtDate_(v) {
  if (v instanceof Date && !isNaN(v)) return Utilities.formatDate(v, TZ, 'yyyy-MM-dd');
  return parseLooseDate_(v) || '';
}

/** Accepts yyyy-mm-dd or dd/mm/yyyy (what Ibu might type in Data). */
function parseLooseDate_(v) {
  var s = text_(v).trim(), m, y, mo, d;
  if ((m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s))) { y = +m[1]; mo = +m[2]; d = +m[3]; }
  else if ((m = /^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{2}|\d{4})$/.exec(s))) { d = +m[1]; mo = +m[2]; y = +m[3]; if (y < 100) y += 2000; }
  else return '';
  var dt = new Date(y, mo - 1, d, 12);   // reject 31/02, 13/13 …
  if (dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) return '';
  return y + '-' + ('0' + mo).slice(-2) + '-' + ('0' + d).slice(-2);
}

/** Cells Ibu typed by hand: a text date becomes a real date, a text amount ("350.000", "Rp 1.500") a number. */
function normalizeTypedRow_(r) {
  var changed = false;
  if (typeof r[C.DATE] === 'string' && r[C.DATE]) {
    var d = parseLooseDate_(r[C.DATE]);
    if (d) { r[C.DATE] = toDate_(d); changed = true; }
  }
  if (typeof r[C.AMT] === 'string' && /\d/.test(r[C.AMT]) && !/[.,]\d{1,2}$/.test(r[C.AMT].trim())) {
    var a = Number(r[C.AMT].replace(/[^\d]/g, ''));
    if (a > 0) { r[C.AMT] = a; changed = true; }
  }
  return changed;
}

function fmtDateTime_(v) { return v instanceof Date && !isNaN(v) ? Utilities.formatDate(v, TZ, "yyyy-MM-dd'T'HH:mm:ss") : ''; }
function toTime_(v) { return v instanceof Date ? v.getTime() : 0; }
function toDate_(s) { var p = String(s).split('-').map(Number); return new Date(p[0], p[1] - 1, p[2], 12, 0, 0); }
function addDays_(s, n) { var d = toDate_(s); d.setDate(d.getDate() + n); return Utilities.formatDate(d, TZ, 'yyyy-MM-dd'); }
function dmy_(s) { return s ? s.slice(8, 10) + '/' + s.slice(5, 7) + '/' + s.slice(0, 4) : '-'; }
function rupiah_(n) { return 'Rp ' + String(Math.round(n || 0)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
