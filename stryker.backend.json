{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "cd tests && export CODE_FILE=../mutation-src/Code.js TZ=Asia/Jakarta && node backend.test.js && node backend.snapshot.test.js && FC_RUNS=60 FC_SEED=42 node backend.property.test.js"
  },
  "mutate": [
    "mutation-src/Code.js"
  ],
  "ignorePatterns": [
    "web",
    "docs",
    "*.zip",
    "reports"
  ],
  "concurrency": 2,
  "timeoutMS": 15000,
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/backend.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/backend.html"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "coverageAnalysis": "off"
}